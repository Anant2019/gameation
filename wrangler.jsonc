{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gameation",
  "main": "worker.js",
  "compatibility_date": "2026-10-23",
  "workers_dev": true,
  "preview_urls": false,
  "ai": {
    "binding": "AI"
